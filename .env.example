# CWFLY-BOT 环境变量模板
# 复制为 .env 后填入真实值；.env 已被 .gitignore 排除，请勿提交

BOT_WS_HOST=
BOT_WS_PORT=
ONEBOT_ACCESS_TOKEN=
BOT_SELF_ID=
CWFLY_API_URL=
# 机器人调用后端 /api/online/snapshot 的密钥（后端 OPENAPI_KEY）
CWFLY_API_KEY=
DB_HOST=
DB_PORT=
DB_USER=
DB_PASSWORD=
DB_NAME=
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
AI_MODELS=
ALLOWED_GROUP_IDS=
CONTROL_GROUP_ID=
NOTIFY_GROUP_ID=
BOT_ADMIN_QQ=
DOWNLOAD_DIR=
AIRPORT_CACHE_FILE=
# 免播报名单：名单内的管制员（按 CID 或呼号）上线/下线时不推送群通知，多个用逗号分隔
NOTIFY_SKIP_CIDS=
NOTIFY_SKIP_CALLSIGNS=

# QQ 官方机器人：管制上线/下线群播报
# 目标群的 group_openid（也可在目标群发送 /绑定播报 <口令> 自动保存）
QQ_NOTIFY_GROUP_OPENID=
# 绑定口令；为空时禁用 /绑定播报
QQ_NOTIFY_BIND_TOKEN=
QQ_NOTIFY_POLL_SECONDS=8

# 管制信息更新播报（频率 / ATC INFO 变化）
# 上线后多少毫秒内的初始信息不算更新
INFO_UPDATE_GRACE_MS=15000
# 同一席位两次更新播报的最小间隔（毫秒）
INFO_UPDATE_MIN_INTERVAL_MS=60000

# CTYFLY 官方机器人航路 API Token（服务端未配置可留空）
BOT_API_TOKEN=

# 以下为代码实际读取、此前模板缺失的变量
API_BASE=
AUTO_APPROVE_GROUP_IDS=
CALL_2325_QQ=
